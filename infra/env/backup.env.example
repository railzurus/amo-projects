# Подключение к PostgreSQL (те же данные, что в postgres.env)
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=

# Расписание cron в UTC: 0 0 * * * = 03:00 по Москве
BACKUP_SCHEDULE=0 0 * * *
# Сколько дней хранить копии на сервере и в S3
LOCAL_RETENTION_DAYS=3
S3_RETENTION_DAYS=30

# S3 на ДРУГОЙ площадке (например, Cloud.ru Object Storage — 15 ГБ в free tier).
# Если S3_BUCKET пустой — копии остаются только на сервере.
S3_BUCKET=
S3_PREFIX=zurus-api/postgres
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Other
# Endpoint, регион и ключи — из консоли провайдера (у Cloud.ru ключ вида <tenant_id>:<key_id>)
RCLONE_CONFIG_S3_ENDPOINT=https://s3.cloud.ru
RCLONE_CONFIG_S3_REGION=ru-central-1
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
