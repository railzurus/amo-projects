# Переменные для docker-compose.yml и Caddy.
# Скопировать в .env и заполнить.

# A-запись домена должна указывать на IP сервера
API_DOMAIN=api.zurus.tech
# Почта для уведомлений Let's Encrypt о сертификатах
ACME_EMAIL=admin@zurus.tech

# Доступ к api.zurus.tech/logs/
LOGS_USER=admin
# Хэш пароля: docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'пароль'
# Обязательно в одинарных кавычках — в хэше есть символы $
LOGS_PASSWORD_HASH='$2a$14$заменить'
